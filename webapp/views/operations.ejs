<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <%
    function formatMoney(value) {
      return new Intl.NumberFormat('en-GB', {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 2
      }).format(Number(value || 0));
    }

    function formatDate(value) {
      if (!value) return '—';
      return new Date(value).toLocaleDateString('en-GB');
    }

    function daysLate(value) {
      if (!value) return 0;
      const today = new Date();
      const date = new Date(value);
      today.setHours(0, 0, 0, 0);
      date.setHours(0, 0, 0, 0);
      const diff = today - date;
      return Math.max(0, Math.floor(diff / (1000 * 60 * 60 * 24)));
    }

    function badgeClass(value) {
      const map = {
        'New': 'bg-slate-100 text-slate-700',
        'Approved': 'bg-blue-100 text-blue-700',
        'Picking': 'bg-amber-100 text-amber-800',
        'Packed': 'bg-indigo-100 text-indigo-700',
        'Out for delivery': 'bg-purple-100 text-purple-700',
        'Delivered': 'bg-emerald-100 text-emerald-700',
        'Partially delivered': 'bg-orange-100 text-orange-700',
        'Blocked': 'bg-red-100 text-red-700',
        'Cancelled': 'bg-slate-200 text-slate-600',
        'Unpaid': 'bg-red-100 text-red-700',
        'Partially Paid': 'bg-amber-100 text-amber-800',
        'Paid': 'bg-emerald-100 text-emerald-700',
        'Overdue': 'bg-red-100 text-red-700',
        'Allocated': 'bg-blue-100 text-blue-700',
        'Unallocated': 'bg-slate-100 text-slate-700',
        'Partially Fulfilled': 'bg-orange-100 text-orange-700',
        'Fulfilled': 'bg-emerald-100 text-emerald-700',
        'Issue': 'bg-red-100 text-red-700',
        'low stock': 'bg-amber-100 text-amber-800',
        'stockout': 'bg-red-100 text-red-700',
        'negative stock': 'bg-red-200 text-red-800',
        'no movement': 'bg-slate-100 text-slate-700',
        'no movement 30d': 'bg-slate-100 text-slate-700',
        'no movement 60d': 'bg-slate-200 text-slate-700',
        'no movement 90d': 'bg-slate-300 text-slate-800',
        'ok': 'bg-emerald-100 text-emerald-700',
        'Delayed': 'bg-red-100 text-red-700',
        'Scheduled': 'bg-blue-100 text-blue-700',
        'In Progress': 'bg-amber-100 text-amber-800'
      };

      return map[value] || 'bg-slate-100 text-slate-700';
    }

    const attentionCount =
      (lateOrders?.length || 0) +
      (overdueCustomers?.length || 0) +
      (delayedDeliveries?.length || 0) +
      (inventory?.filter(i => i.alert !== 'ok').length || 0);
  %>

  <div class="mx-auto max-w-7xl p-6 space-y-6">
    <div>
      <h1 class="text-2xl font-bold">Operations Control Tower</h1>
      <p class="mt-1 text-sm text-slate-600">
        A quick daily view of orders, stock, deliveries, and collections.
      </p>
    </div>

    <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <strong>Needs attention today:</strong>
      <%= attentionCount %> active issues across late orders, overdue accounts, delayed deliveries, and stock alerts.
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-5">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Orders due today</div>
        <div class="mt-2 text-3xl font-semibold"><%= kpis.orders_due_today || 0 %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Orders late</div>
        <div class="mt-2 text-3xl font-semibold"><%= kpis.orders_late || 0 %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Low stock SKUs</div>
        <div class="mt-2 text-3xl font-semibold"><%= kpis.low_stock_skus || 0 %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Deliveries in progress</div>
        <div class="mt-2 text-3xl font-semibold"><%= kpis.deliveries_in_progress || 0 %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Overdue invoices</div>
        <div class="mt-2 text-3xl font-semibold"><%= kpis.overdue_invoices || 0 %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Today’s sales</div>
        <div class="mt-2 text-3xl font-semibold"><%= formatMoney(kpis.todays_sales) %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">This week’s collections</div>
        <div class="mt-2 text-3xl font-semibold"><%= formatMoney(kpis.this_week_collections) %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Fill rate</div>
        <div class="mt-2 text-3xl font-semibold"><%= Number(kpis.fill_rate || 0).toFixed(2) %>%</div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="text-sm text-slate-500">Order accuracy</div>
        <div class="mt-2 text-3xl font-semibold"><%= Number(kpis.order_accuracy || 0).toFixed(2) %>%</div>
      </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-base font-semibold">Late orders</h2>
        </div>
        <div class="p-4 space-y-3">
          <% if (lateOrders.length) { %>
            <% lateOrders.forEach(order => { %>
              <div class="rounded-xl border border-slate-200 p-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <div class="font-medium"><%= order.order_number %> · <%= order.customer %></div>
                    <div class="text-sm text-slate-500">
                      Requested <%= formatDate(order.requested_delivery_date) %> ·
                      <%= daysLate(order.requested_delivery_date) %> day(s) late
                    </div>
                  </div>
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(order.status) %>">
                    <%= order.status %>
                  </span>
                </div>
                <div class="mt-2 flex flex-wrap gap-2 text-xs text-slate-600">
                  <span>Total <%= formatMoney(order.total_value) %></span>
                  <span>•</span>
                  <span>Payment <%= order.payment_status %></span>
                  <span>•</span>
                  <span>Fulfilment <%= order.fulfilment_status %></span>
                  <span>•</span>
                  <span><%= order.assigned_driver_or_route || 'No route assigned' %></span>
                </div>
                <% if (order.notes) { %>
                  <div class="mt-2 text-sm text-slate-700"><%= order.notes %></div>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-sm text-slate-500">No late orders.</div>
          <% } %>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-base font-semibold">Delayed deliveries</h2>
        </div>
        <div class="p-4 space-y-3">
          <% if (delayedDeliveries.length) { %>
            <% delayedDeliveries.forEach(delivery => { %>
              <div class="rounded-xl border border-slate-200 p-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <div class="font-medium"><%= delivery.order_number %> · <%= delivery.customer %></div>
                    <div class="text-sm text-slate-500">
                      Scheduled <%= formatDate(delivery.scheduled_date) %>
                    </div>
                  </div>
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(delivery.status) %>">
                    <%= delivery.status %>
                  </span>
                </div>
                <div class="mt-2 text-sm text-slate-600">
                  Assigned: <%= delivery.assigned %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-sm text-slate-500">No delayed deliveries.</div>
          <% } %>
        </div>
      </section>
    </div>

    <div class="grid gap-6 xl:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-base font-semibold">Customers who owe money</h2>
        </div>
        <div class="p-4 overflow-x-auto">
          <% if (overdueCustomers.length) { %>
            <table class="min-w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-left text-slate-500">
                  <th class="pb-2 pr-4 font-medium">Customer</th>
                  <th class="pb-2 pr-4 font-medium">Overdue invoices</th>
                  <th class="pb-2 pr-4 font-medium">Overdue amount</th>
                </tr>
              </thead>
              <tbody>
                <% overdueCustomers.forEach(customer => { %>
                  <tr class="border-b border-slate-100">
                    <td class="py-3 pr-4 font-medium"><%= customer.name %></td>
                    <td class="py-3 pr-4"><%= customer.overdue_invoice_count %></td>
                    <td class="py-3 pr-4"><%= formatMoney(customer.overdue_amount) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="text-sm text-slate-500">No overdue customers.</div>
          <% } %>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-base font-semibold">Inventory alerts</h2>
        </div>
        <div class="p-4 space-y-3">
          <% const inventoryAlerts = inventory.filter(item => item.alert !== 'ok'); %>
          <% if (inventoryAlerts.length) { %>
            <% inventoryAlerts.forEach(item => { %>
              <div class="rounded-xl border border-slate-200 p-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <div class="font-medium"><%= item.sku_code %> · <%= item.name %></div>
                    <div class="text-sm text-slate-500">
                      <%= item.category || 'Uncategorised' %> · <%= item.supplier || 'No supplier' %>
                    </div>
                  </div>
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(item.alert) %>">
                    <%= item.alert %>
                  </span>
                </div>

                <div class="mt-2 grid grid-cols-2 gap-2 text-sm text-slate-700 md:grid-cols-4">
                  <div>Current: <%= item.current_stock %></div>
                  <div>Allocated: <%= item.allocated_stock %></div>
                  <div>Available: <%= item.available_stock %></div>
                  <div>Reorder point: <%= item.reorder_point %></div>
                </div>

                <div class="mt-2 text-xs text-slate-500">
                  Last movement: <%= formatDate(item.last_movement_at) %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-sm text-slate-500">No inventory alerts.</div>
          <% } %>
        </div>
      </section>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-3">
        <h2 class="text-base font-semibold">Orders</h2>
      </div>
      <div class="overflow-x-auto p-4">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-slate-500">
              <th class="pb-2 pr-4 font-medium">Order</th>
              <th class="pb-2 pr-4 font-medium">Customer</th>
              <th class="pb-2 pr-4 font-medium">Order date</th>
              <th class="pb-2 pr-4 font-medium">Delivery date</th>
              <th class="pb-2 pr-4 font-medium">Status</th>
              <th class="pb-2 pr-4 font-medium">Value</th>
              <th class="pb-2 pr-4 font-medium">Payment</th>
              <th class="pb-2 pr-4 font-medium">Fulfilment</th>
              <th class="pb-2 pr-4 font-medium">Driver / Route</th>
              <th class="pb-2 pr-4 font-medium">Notes / Issues</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { 
              const isLate =
                order.requested_delivery_date &&
                new Date(order.requested_delivery_date) < new Date(new Date().toDateString()) &&
                !['Delivered', 'Cancelled'].includes(order.status);
            %>
              <tr class="border-b border-slate-100 <%= isLate ? 'bg-red-50' : '' %>">
                <td class="py-3 pr-4 font-medium"><%= order.order_number %></td>
                <td class="py-3 pr-4"><%= order.customer %></td>
                <td class="py-3 pr-4"><%= formatDate(order.order_date) %></td>
                <td class="py-3 pr-4"><%= formatDate(order.requested_delivery_date) %></td>
                <td class="py-3 pr-4">
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(order.status) %>">
                    <%= order.status %>
                  </span>
                </td>
                <td class="py-3 pr-4"><%= formatMoney(order.total_value) %></td>
                <td class="py-3 pr-4">
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(order.payment_status) %>">
                    <%= order.payment_status %>
                  </span>
                </td>
                <td class="py-3 pr-4">
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(order.fulfilment_status) %>">
                    <%= order.fulfilment_status %>
                  </span>
                </td>
                <td class="py-3 pr-4"><%= order.assigned_driver_or_route || '—' %></td>
                <td class="py-3 pr-4"><%= order.notes || (isLate ? 'Late order needs action' : '—') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-3">
        <h2 class="text-base font-semibold">Inventory</h2>
      </div>
      <div class="overflow-x-auto p-4">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-slate-500">
              <th class="pb-2 pr-4 font-medium">SKU</th>
              <th class="pb-2 pr-4 font-medium">Name</th>
              <th class="pb-2 pr-4 font-medium">Category</th>
              <th class="pb-2 pr-4 font-medium">Current stock</th>
              <th class="pb-2 pr-4 font-medium">Allocated</th>
              <th class="pb-2 pr-4 font-medium">Available</th>
              <th class="pb-2 pr-4 font-medium">Reorder point</th>
              <th class="pb-2 pr-4 font-medium">Supplier</th>
              <th class="pb-2 pr-4 font-medium">Last movement</th>
              <th class="pb-2 pr-4 font-medium">Alert</th>
            </tr>
          </thead>
          <tbody>
            <% inventory.forEach(item => { %>
              <tr class="border-b border-slate-100">
                <td class="py-3 pr-4 font-medium"><%= item.sku_code %></td>
                <td class="py-3 pr-4"><%= item.name %></td>
                <td class="py-3 pr-4"><%= item.category || '—' %></td>
                <td class="py-3 pr-4"><%= item.current_stock %></td>
                <td class="py-3 pr-4"><%= item.allocated_stock %></td>
                <td class="py-3 pr-4"><%= item.available_stock %></td>
                <td class="py-3 pr-4"><%= item.reorder_point %></td>
                <td class="py-3 pr-4"><%= item.supplier || '—' %></td>
                <td class="py-3 pr-4"><%= formatDate(item.last_movement_at) %></td>
                <td class="py-3 pr-4">
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= badgeClass(item.alert) %>">
                    <%= item.alert %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</body>
</html>