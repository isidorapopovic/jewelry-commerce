<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body data-page="operations">
    <%
        function formatMoney(value) {
            return new Intl.NumberFormat('en-GB', {
                style: 'currency',
                currency: 'EUR',
                maximumFractionDigits: 2
            }).format(Number(value || 0));
        }

        function formatDate(value) {
            if (!value) return '—';
            return new Date(value).toLocaleDateString('en-GB');
        }

        function daysLate(value) {
            if (!value) return 0;
            const today = new Date();
            const date = new Date(value);
            today.setHours(0, 0, 0, 0);
            date.setHours(0, 0, 0, 0);
            return Math.max(0, Math.floor((today - date) / (1000 * 60 * 60 * 24)));
        }

        function badgeTint(value) {
            const good = ['Delivered', 'Paid', 'Fulfilled', 'Allocated', 'ok', 'Approved'];
            const warn = ['Picking', 'Packed', 'Out for delivery', 'Partially delivered',
                'Partially Paid', 'Partially Fulfilled', 'low stock', 'no movement',
                'no movement 30d', 'no movement 60d', 'no movement 90d', 'In Progress', 'Scheduled'];
            const bad = ['Blocked', 'Cancelled', 'Unpaid', 'Overdue', 'Issue',
                'stockout', 'negative stock', 'Delayed'];
            if (good.includes(value)) return 'is-good';
            if (warn.includes(value)) return 'is-warn';
            if (bad.includes(value)) return 'is-bad';
            return '';
        }

        const attentionCount =
            (lateOrders?.length || 0) +
            (overdueCustomers?.length || 0) +
            (delayedDeliveries?.length || 0) +
            (inventory?.filter(i => i.alert !== 'ok').length || 0);

        const inventoryAlerts = inventory.filter(item => item.alert !== 'ok');
    %>

    <aside class="side-nav" aria-label="Main navigation">
        <div class="side-nav-inner">
            <div class="side-brand">
                <span class="dot"></span>
                <span class="side-brand-text">Firma</span>
            </div>

            <nav class="side-menu">
                <a href="/" data-nav="home" class="side-link">
                    <span class="side-icon">⌂</span>
                    <span class="side-text">Home</span>
                </a>
                <a href="/overview" data-nav="overview" class="side-link">
                    <span class="side-icon">◫</span>
                    <span class="side-text">Overview</span>
                </a>
                <a href="/kpi" data-nav="kpi" class="side-link">
                    <span class="side-icon">◩</span>
                    <span class="side-text">KPI</span>
                </a>
                <a href="/operations" data-nav="operations" class="side-link active">
                    <span class="side-icon">◎</span>
                    <span class="side-text">Operations</span>
                </a>
                <a href="/transactions" data-nav="transactions" class="side-link">
                    <span class="side-icon">⇄</span>
                    <span class="side-text">Transactions</span>
                </a>
                <a href="/automation" data-nav="automation" class="side-link">
                    <span class="side-icon">⚙</span>
                    <span class="side-text">Automation</span>
                </a>
                <a href="/visualizations" data-nav="visualizations" class="side-link">
                    <span class="side-icon">◔</span>
                    <span class="side-text">Visualizations</span>
                </a>
                <a href="/products" data-nav="products" class="side-link">
                    <span class="side-icon">▣</span>
                    <span class="side-text">Products</span>
                </a>
                <a href="/imports" data-nav="imports" class="side-link">
                    <span class="side-icon">⇪</span>
                    <span class="side-text">Imports</span>
                </a>
            </nav>
        </div>
    </aside>

    <main class="page-shell app-page-shell">
        <div class="ops-container">

            <section class="hero">
                <div>
                    <h1>Operations Control Tower</h1>
                    <p>A quick daily view of orders, stock, deliveries, and collections.</p>
                </div>
                <a href="/operations" class="ops-refresh-btn">↻ Refresh</a>
            </section>

            <div class="attention">
                <strong>Needs attention today:</strong>
                <%= attentionCount %> active issues across late orders, overdue accounts,
                delayed deliveries, and stock alerts.
            </div>

            <section class="ops-stats">
                <div class="kpi"><div class="label">Orders due today</div><div class="value"><%= kpis.orders_due_today || 0 %></div></div>
                <div class="kpi"><div class="label">Orders late</div><div class="value"><%= kpis.orders_late || 0 %></div></div>
                <div class="kpi"><div class="label">Low stock SKUs</div><div class="value"><%= kpis.low_stock_skus || 0 %></div></div>
                <div class="kpi"><div class="label">Deliveries in progress</div><div class="value"><%= kpis.deliveries_in_progress || 0 %></div></div>
                <div class="kpi"><div class="label">Overdue invoices</div><div class="value"><%= kpis.overdue_invoices || 0 %></div></div>
                <div class="kpi"><div class="label">Today’s sales</div><div class="value"><%= formatMoney(kpis.todays_sales) %></div></div>
                <div class="kpi"><div class="label">This week’s collections</div><div class="value"><%= formatMoney(kpis.this_week_collections) %></div></div>
                <div class="kpi"><div class="label">Fill rate</div><div class="value"><%= Number(kpis.fill_rate || 0).toFixed(1) %>%</div></div>
                <div class="kpi"><div class="label">Order accuracy</div><div class="value"><%= Number(kpis.order_accuracy || 0).toFixed(1) %>%</div></div>
            </section>

            <div class="split">
                <section class="panel">
                    <h2>Late orders</h2>
                    <% if (lateOrders.length) { %>
                        <% lateOrders.forEach(order => { %>
                            <div class="ops-card">
                                <div class="ops-card-head">
                                    <div>
                                        <div class="ops-card-title"><%= order.order_number %> · <%= order.customer %></div>
                                        <div class="ops-card-sub">
                                            Requested <%= formatDate(order.requested_delivery_date) %> ·
                                            <%= daysLate(order.requested_delivery_date) %> day(s) late
                                        </div>
                                    </div>
                                    <span class="badge <%= badgeTint(order.status) %>"><%= order.status %></span>
                                </div>
                                <div class="ops-card-meta">
                                    <span>Total <%= formatMoney(order.total_value) %></span>
                                    <span>•</span>
                                    <span>Payment <%= order.payment_status %></span>
                                    <span>•</span>
                                    <span>Fulfilment <%= order.fulfilment_status %></span>
                                    <span>•</span>
                                    <span><%= order.assigned_driver_or_route || 'No route assigned' %></span>
                                </div>
                                <% if (order.notes) { %>
                                    <div class="ops-card-note"><%= order.notes %></div>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="note">No late orders.</p>
                    <% } %>
                </section>

                <section class="panel">
                    <h2>Delayed deliveries</h2>
                    <% if (delayedDeliveries.length) { %>
                        <% delayedDeliveries.forEach(delivery => { %>
                            <div class="ops-card">
                                <div class="ops-card-head">
                                    <div>
                                        <div class="ops-card-title"><%= delivery.order_number %> · <%= delivery.customer %></div>
                                        <div class="ops-card-sub">Scheduled <%= formatDate(delivery.scheduled_date) %></div>
                                    </div>
                                    <span class="badge <%= badgeTint(delivery.status) %>"><%= delivery.status %></span>
                                </div>
                                <div class="ops-card-meta"><span>Assigned: <%= delivery.assigned %></span></div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="note">No delayed deliveries.</p>
                    <% } %>
                </section>
            </div>

            <div class="split">
                <section class="panel">
                    <h2>Customers who owe money</h2>
                    <% if (overdueCustomers.length) { %>
                        <div class="table-wrap">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Overdue invoices</th>
                                        <th>Overdue amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% overdueCustomers.forEach(customer => { %>
                                        <tr>
                                            <td><%= customer.name %></td>
                                            <td><%= customer.overdue_invoice_count %></td>
                                            <td><%= formatMoney(customer.overdue_amount) %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p class="note">No overdue customers.</p>
                    <% } %>
                </section>

                <section class="panel">
                    <h2>Inventory alerts</h2>
                    <% if (inventoryAlerts.length) { %>
                        <% inventoryAlerts.forEach(item => { %>
                            <div class="ops-card">
                                <div class="ops-card-head">
                                    <div>
                                        <div class="ops-card-title"><%= item.sku_code %> · <%= item.name %></div>
                                        <div class="ops-card-sub">
                                            <%= item.category || 'Uncategorised' %> · <%= item.supplier || 'No supplier' %>
                                        </div>
                                    </div>
                                    <span class="badge <%= badgeTint(item.alert) %>"><%= item.alert %></span>
                                </div>
                                <div class="ops-card-meta">
                                    <span>Current: <%= item.current_stock %></span>
                                    <span>Allocated: <%= item.allocated_stock %></span>
                                    <span>Available: <%= item.available_stock %></span>
                                    <span>Reorder point: <%= item.reorder_point %></span>
                                </div>
                                <div class="ops-card-note">Last movement: <%= formatDate(item.last_movement_at) %></div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="note">No inventory alerts.</p>
                    <% } %>
                </section>
            </div>

            <section class="panel">
                <h2>Orders</h2>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Order date</th>
                                <th>Delivery date</th>
                                <th>Status</th>
                                <th>Value</th>
                                <th>Payment</th>
                                <th>Fulfilment</th>
                                <th>Driver / Route</th>
                                <th>Notes / Issues</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(order => {
                                const isLate =
                                    order.requested_delivery_date &&
                                    new Date(order.requested_delivery_date) < new Date(new Date().toDateString()) &&
                                    !['Delivered', 'Cancelled'].includes(order.status);
                            %>
                                <tr class="<%= isLate ? 'row-late' : '' %>">
                                    <td><strong><%= order.order_number %></strong></td>
                                    <td><%= order.customer %></td>
                                    <td><%= formatDate(order.order_date) %></td>
                                    <td><%= formatDate(order.requested_delivery_date) %></td>
                                    <td><span class="badge <%= badgeTint(order.status) %>"><%= order.status %></span></td>
                                    <td><%= formatMoney(order.total_value) %></td>
                                    <td><span class="badge <%= badgeTint(order.payment_status) %>"><%= order.payment_status %></span></td>
                                    <td><span class="badge <%= badgeTint(order.fulfilment_status) %>"><%= order.fulfilment_status %></span></td>
                                    <td><%= order.assigned_driver_or_route || '—' %></td>
                                    <td><%= order.notes || (isLate ? 'Late order needs action' : '—') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel">
                <h2>Inventory</h2>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Current stock</th>
                                <th>Allocated</th>
                                <th>Available</th>
                                <th>Reorder point</th>
                                <th>Supplier</th>
                                <th>Last movement</th>
                                <th>Alert</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% inventory.forEach(item => { %>
                                <tr>
                                    <td><strong><%= item.sku_code %></strong></td>
                                    <td><%= item.name %></td>
                                    <td><%= item.category || '—' %></td>
                                    <td><%= item.current_stock %></td>
                                    <td><%= item.allocated_stock %></td>
                                    <td><%= item.available_stock %></td>
                                    <td><%= item.reorder_point %></td>
                                    <td><%= item.supplier || '—' %></td>
                                    <td><%= formatDate(item.last_movement_at) %></td>
                                    <td><span class="badge <%= badgeTint(item.alert) %>"><%= item.alert %></span></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

        </div>
    </main>
</body>
</html>
