<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Transactions Hub</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body data-page="transactions">
    <aside class="side-nav" aria-label="Main navigation">
        <div class="side-nav-inner">
            <div class="side-brand">
                <span class="dot"></span>
                <span class="side-brand-text">Firma</span>
            </div>

            <nav class="side-menu">
                <a href="/" data-nav="home" class="side-link">
                    <span class="side-icon">⌂</span>
                    <span class="side-text">Home</span>
                </a>
                <a href="/overview" data-nav="overview" class="side-link">
                    <span class="side-icon">◫</span>
                    <span class="side-text">Overview</span>
                </a>
                <a href="/kpi" data-nav="kpi" class="side-link">
                    <span class="side-icon">◩</span>
                    <span class="side-text">KPI</span>
                </a>
                <a href="/transactions" data-nav="transactions" class="side-link active">
                    <span class="side-icon">⇄</span>
                    <span class="side-text">Transactions</span>
                </a>
                <a href="/automation" data-nav="automation" class="side-link">
                    <span class="side-icon">⚙</span>
                    <span class="side-text">Automation</span>
                </a>
                <a href="/visualizations" data-nav="visualizations" class="side-link">
                    <span class="side-icon">◔</span>
                    <span class="side-text">Visualizations</span>
                </a>
				<a href="/products" data-nav="products" class="side-link">
					<span class="side-icon">▣</span>
					<span class="side-text">Products</span>
				</a>
				<a href="/imports" data-nav="imports" class="side-link">
					<span class="side-icon">⇪</span>
					<span class="side-text">Imports</span>
				</a>
            </nav>
        </div>
    </aside>

    <main class="page-shell app-page-shell">
        <div class="container">
            <div class="page-actions">
                <a class="finance-btn" href="/finance-centre">Open Finance Centre</a>
            </div>

            <section class="hero">
                <h1>Transactions Hub</h1>
                <p>Add and delete transactions (working backend + frontend).</p>
            </section>

            <section class="panel split">
                <div>
                    <h2>Transactions</h2>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="txTableBody"></tbody>
                    </table>
                </div>

                <div>
                    <h2>Add transaction</h2>
                    <form id="txForm" class="form">
                        <div class="field">
                            <label for="txDate">Date (YYYY-MM-DD)</label>
                            <input id="txDate" name="date" placeholder="2026-02-26" required />
                        </div>

                        <div class="field">
                            <label for="txDescription">Description</label>
                            <input id="txDescription" name="description" placeholder="Invoice / Payment / Rent…" required />
                        </div>

                        <div class="field">
                            <label for="txCategory">Category</label>
                            <input id="txCategory" name="category" placeholder="Sales / Operations / Services…" />
                        </div>

                        <div class="field">
                            <label for="txType">Type</label>
                            <select id="txType" name="type" required>
                                <option value="income">income</option>
                                <option value="expense">expense</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="txAmount">Amount</label>
                            <input id="txAmount" name="amount" type="number" step="0.01" placeholder="100.00" required />
                        </div>

                        <button class="btn" type="submit">Add</button>

                        <p class="note">
                            This is stored in memory (resets when server restarts). Next step later: SQLite/database.
                        </p>
                    </form>
                </div>
            </section>

            <div id="toast" class="toast" role="status" aria-live="polite"></div>
        </div>
    </main>

    <script src="/js/main.js"></script>
</body>
</html>