<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Products</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body data-page="products">
    <aside class="side-nav" aria-label="Main navigation">
        <div class="side-nav-inner">
            <div class="side-brand">
                <span class="dot"></span>
                <span class="side-brand-text">Firma</span>
            </div>

            <nav class="side-menu">
                <a href="/" data-nav="home" class="side-link">
                    <span class="side-icon">⌂</span>
                    <span class="side-text">Home</span>
                </a>
                <a href="/overview" data-nav="overview" class="side-link">
                    <span class="side-icon">◫</span>
                    <span class="side-text">Overview</span>
                </a>
                <a href="/kpi" data-nav="kpi" class="side-link">
                    <span class="side-icon">◩</span>
                    <span class="side-text">KPI</span>
                </a>
                <a href="/transactions" data-nav="transactions" class="side-link">
                    <span class="side-icon">⇄</span>
                    <span class="side-text">Transactions</span>
                </a>
                <a href="/automation" data-nav="automation" class="side-link">
                    <span class="side-icon">⚙</span>
                    <span class="side-text">Automation</span>
                </a>
                <a href="/visualizations" data-nav="visualizations" class="side-link">
                    <span class="side-icon">◔</span>
                    <span class="side-text">Visualizations</span>
                </a>
                <a href="/products" data-nav="products" class="side-link">
                    <span class="side-icon">▣</span>
                    <span class="side-text">Products</span>
                </a>
                <a href="/imports" data-nav="imports" class="side-link">
					<span class="side-icon">⇪</span>
					<span class="side-text">Imports</span>
				</a>

            </nav>
        </div>
    </aside>

    <main class="page-shell app-page-shell">
        <div class="container">
            <section class="hero">
                <h1>Products</h1>
                <p>Live product catalogue from the backend API.</p>
            </section>

            <section class="panel">
                <h2>Product list</h2>
                <div id="productsNote" class="note">Loading…</div>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>SKU</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Currency</th>
                            <th>Stock</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="productsTable"></tbody>
                </table>
            </section>

            <div id="toast" class="toast" role="status" aria-live="polite"></div>
        </div>
    </main>

    <script>
        async function loadProducts() {
            const note = document.getElementById("productsNote");
            const tbody = document.getElementById("productsTable");

            try {
                const res = await fetch("/api/products");
                if (!res.ok) {
                    throw new Error(`HTTP ${res.status}`);
                }

                const data = await res.json();
                const items = Array.isArray(data.items) ? data.items : [];

                if (!items.length) {
                    note.textContent = "No products found.";
                    tbody.innerHTML = "";
                    return;
                }

                note.textContent = `${items.length} product${items.length === 1 ? "" : "s"} found.`;

                tbody.innerHTML = items.map((item) => `
                    <tr>
                        <td>${escapeHtml(item.name ?? "")}</td>
                        <td>${escapeHtml(item.sku ?? "—")}</td>
                        <td>${escapeHtml(item.category ?? "—")}</td>
                        <td>${formatNumber(item.price)}</td>
                        <td>${escapeHtml(item.currency ?? "USD")}</td>
                        <td>${Number(item.stock_quantity ?? 0)}</td>
                        <td>${item.is_active ? "Active" : "Inactive"}</td>
                    </tr>
                `).join("");
            } catch (err) {
                console.error(err);
                note.textContent = "Could not load products.";
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7">Failed to load products.</td>
                    </tr>
                `;
            }
        }

        function formatNumber(value) {
            const num = Number(value ?? 0);
            return Number.isFinite(num) ? num.toFixed(2) : "0.00";
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        loadProducts();
    </script>

    <script src="/js/main.js"></script>
</body>
</html>